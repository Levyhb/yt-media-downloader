@page "/"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject DownloadApiClient ApiClient
@inject IJSRuntime JS

<PageTitle>YTDrop — YouTube Downloader</PageTitle>

<main class="app-shell">
    <div class="glow glow-one"></div><div class="glow glow-two"></div>
    <section class="hero" aria-labelledby="page-title">
        <div class="brand-mark"><span>▶</span></div>
        <p class="eyebrow">YTDROP / MEDIA TOOL</p>
        <h1 id="page-title">Seu vídeo.<br /><span>Do seu jeito.</span></h1>
        <p class="subtitle">Cole um link do YouTube, escolha o formato e baixe em poucos segundos.</p>

        <div class="url-row">
            <div class="url-field">
                <span class="link-icon" aria-hidden="true">↗</span>
                <label class="visually-hidden" for="youtube-url">URL do vídeo do YouTube</label>
                <input id="youtube-url" type="url" placeholder="Cole a URL do YouTube aqui..." value="@url" @oninput="HandleUrlInputAsync" @onblur="LoadVideoAsync" @onkeydown="HandleKeyDown" />
                @if (!string.IsNullOrWhiteSpace(url)) { <button class="clear-button" type="button" aria-label="Limpar URL" @onclick="ClearUrl">×</button> }
            </div>
            <button class="format-toggle" type="button" @onclick="ToggleFormat"><span class="format-icon">@(downloadType == "audio" ? "♫" : "▶")</span><span>@(downloadType == "audio" ? "Áudio" : "Vídeo")</span><span class="chevron" aria-hidden="true"></span></button>
        </div>
        @if (showFormatMenu)
        {
            <div class="format-menu" role="menu">
                <button type="button" @onclick='() => SelectFormat("video")'>▶ Vídeo <small>MP4</small></button>
                <button type="button" @onclick='() => SelectFormat("audio")'>♫ Áudio <small>MP3</small></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage)) { <p class="error-message" role="alert">@errorMessage</p> }

        @if (previewVideoId is not null)
        {
            @if (downloadType == "video")
            {
                <div class="quality-section">
                    <div class="quality-heading"><span>Qualidade do vídeo</span>@if (isLoading) { <small>Consultando formatos...</small> }</div>
                    <div class="quality-list" role="group" aria-label="Qualidade do vídeo" aria-busy="@isLoading">
                        @if (isLoading)
                        {
                            @foreach (var width in qualitySkeletonWidths)
                            { <span class="quality-skeleton" style="width: @(width)px" aria-hidden="true"></span> }
                        }
                        else if (videoInfo is not null)
                        {
                            @foreach (var quality in videoInfo.Qualities.OrderByDescending(x => x))
                            { <button type="button" class="quality-button @(selectedQuality == quality ? "selected" : "")" @onclick="() => selectedQuality = quality">@(quality)p</button> }
                        }
                    </div>
                </div>
            }
            <div class="preview-card"><div class="preview-heading"><span>PRÉVIA</span><strong>@(videoInfo?.Title ?? "Vídeo do YouTube")</strong></div><div class="video-frame @(isPreviewLoading ? "is-loading" : "")">
                @if (isPreviewLoading) { <div class="preview-loading" role="status"><span class="spinner"></span> Carregando vídeo...</div> }
                <iframe @key="previewVideoId" src="@PreviewUrl" title="Prévia do vídeo" @onload="HandlePreviewLoaded" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div></div>
            @if (videoInfo is not null)
            {
                <button type="button" class="download-action @(isPreparing ? (downloadProgress.HasValue ? "has-progress" : "is-preparing") : "")" style="--download-progress: @(downloadProgress ?? 0)%" disabled="@isPreparing" aria-busy="@isPreparing" @onclick="StartDownloadAsync">
                    <span class="download-progress-track" aria-hidden="true"></span>
                    <span class="download-button-content">
                        @if (isPreparing) { <span class="spinner" aria-hidden="true"></span> }
                        else { <span class="download-icon">@(downloadType == "audio" ? "♫" : "↓")</span> }
                        <span>@DownloadButtonText</span>
                        @if (!isPreparing) { <span class="action-arrow" aria-hidden="true">→</span> }
                    </span>
                </button>
            }
        }
        <p class="privacy-note">✦ Gratuito para uso pessoal · Nenhum arquivo é armazenado</p>
    </section>
</main>

@code {
    private string url = string.Empty;
    private string downloadType = "video";
    private VideoInfo? videoInfo;
    private string? previewVideoId;
    private string? loadedVideoId;
    private string? errorMessage;
    private bool isLoading, isPreparing, isPreviewLoading, showFormatMenu;
    private double? downloadProgress;
    private int selectedQuality = 720;
    private static readonly int[] qualitySkeletonWidths = [62, 58, 58, 54, 54];
    private CancellationTokenSource? loadCancellation;
    private string PreviewUrl => $"https://www.youtube.com/embed/{previewVideoId}?rel=0&modestbranding=1";
    private string DownloadButtonText => isPreparing
        ? downloadProgress.HasValue
            ? $"Baixando... {Math.Round(downloadProgress.Value)}%"
            : "Preparando seu arquivo..."
        : $"Baixar {(downloadType == "audio" ? "áudio MP3" : $"vídeo {selectedQuality}p")}";

    private async Task HandleKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await LoadVideoAsync(); }
    private async Task HandleUrlInputAsync(ChangeEventArgs args)
    {
        url = args.Value?.ToString() ?? string.Empty;
        await LoadVideoAsync(450, false);
    }

    private Task LoadVideoAsync() => LoadVideoAsync(0, true);

    private async Task LoadVideoAsync(int delayMilliseconds, bool showValidation)
    {
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        loadCancellation = cancellation;
        errorMessage = null;

        if (!ApiClient.TryGetYouTubeVideoId(url, out var videoId))
        {
            previewVideoId = null;
            loadedVideoId = null;
            videoInfo = null;
            isLoading = false;
            isPreviewLoading = false;
            if (showValidation && !string.IsNullOrWhiteSpace(url))
                errorMessage = "Informe uma URL válida de um vídeo do YouTube.";
            return;
        }

        var videoChanged = previewVideoId != videoId;
        previewVideoId = videoId;
        if (videoChanged)
        {
            videoInfo = null;
            loadedVideoId = null;
            isPreviewLoading = true;
        }

        if (videoInfo is not null && loadedVideoId == videoId) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            if (delayMilliseconds > 0)
                await Task.Delay(delayMilliseconds, cancellation.Token);

            var result = await ApiClient.GetVideoInfoAsync(url, cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();
            if (previewVideoId != videoId) return;

            videoInfo = result;
            loadedVideoId = videoId;
            selectedQuality = videoInfo?.Qualities.Contains(720) == true
                ? 720
                : videoInfo?.Qualities.LastOrDefault() ?? 360;
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            if (!cancellation.IsCancellationRequested)
                errorMessage = "O vídeo abriu, mas não foi possível consultar os formatos disponíveis.";
        }
        finally
        {
            if (ReferenceEquals(loadCancellation, cancellation))
                isLoading = false;
        }
    }

    private void HandlePreviewLoaded() => isPreviewLoading = false;
    private void ToggleFormat() => showFormatMenu = !showFormatMenu;
    private void SelectFormat(string type) { downloadType = type; showFormatMenu = false; }
    private void ClearUrl()
    {
        loadCancellation?.Cancel();
        url = string.Empty;
        previewVideoId = null;
        loadedVideoId = null;
        videoInfo = null;
        errorMessage = null;
        isLoading = false;
        isPreviewLoading = false;
    }
    private async Task StartDownloadAsync()
    {
        if (videoInfo is null || isPreparing) return;

        isPreparing = true;
        downloadProgress = null;
        errorMessage = null;

        try
        {
            using var reference = DotNetObjectReference.Create(this);
            var extension = downloadType == "audio" ? ".mp3" : ".mp4";
            var contentType = downloadType == "audio" ? "audio/mpeg" : "video/mp4";
            var filename = $"{SanitizeFilename(videoInfo.Title)}{extension}";
            await JS.InvokeAsync<bool>(
                "ytDrop.download",
                ApiClient.BuildDownloadUrl(url, downloadType, selectedQuality),
                filename,
                contentType,
                reference);
        }
        catch (JSException)
        {
            errorMessage = "Não foi possível concluir o download. Tente novamente.";
        }
        finally
        {
            isPreparing = false;
            downloadProgress = null;
        }
    }

    [JSInvokable]
    public Task UpdateDownloadProgress(double progress)
    {
        downloadProgress = progress < 0 ? null : Math.Clamp(progress, 0, 100);
        return InvokeAsync(StateHasChanged);
    }

    private static string SanitizeFilename(string? title)
    {
        const string invalidCharacters = "<>:\"/\\|?*";
        var sanitized = new string((title ?? "download")
            .Where(character => !char.IsControl(character) && !invalidCharacters.Contains(character))
            .Take(120)
            .ToArray())
            .Trim(' ', '.');
        return string.IsNullOrWhiteSpace(sanitized) ? "download" : sanitized;
    }
}
